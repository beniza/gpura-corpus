   81,
   1648,
   578,
   37
  ],
  "text": "അവരുടെ വിശ്വാസത്തിനു്, തൻമൂലം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l015": {
  "bbox": [
   81,
   1690,
   576,
   37
  ],
  "text": "നിത്യരക്ഷയ്ക്കു് അപകടമില്ലെന്നു് ഇന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l016": {
  "bbox": [
   79,
   1729,
   580,
   36
  ],
  "text": "ത്തെ സാഹചര്യങ്ങളിൽ നിങ്ങളാരെങ്കി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l017": {
  "bbox": [
   78,
   1765,
   581,
   47
  ],
  "text": "ലും അഭിപ്രായപ്പെടുമോ? ഇപ്പോൾ കാജി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l018": {
  "bbox": [
   79,
   1808,
   578,
   39
  ],
  "text": "വിതമാകുന്ന മഹാസമുദ്രത്തിൽ നീന്തി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l019": {
  "bbox": [
   79,
   1849,
   575,
   34
  ],
  "text": "ത്തുടിക്കുന്ന ക്രിസ്തീയജനത തിരു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l020": {
  "bbox": [
   77,
   1888,
   585,
   39
  ],
  "text": "സഭയാകുന്ന ഉറച്ച പാറയിൽ പിടി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r20_l021": {
  "bbox": [
   79,
   1931,
   571,
   33
  ],
  "text": "ച്ചുനിന്നു രക്ഷപെടുന്നതു്. അവരുടെ സ്വ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l001": {
  "bbox": [
   692,
   1142,
   576,
   35
  ],
  "text": "തന്റെ പ്രതാപമെല്ലാം അസ്തമിക്കും.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l002": {
  "bbox": [
   690,
   1181,
   570,
   42
  ],
  "text": "അള അവൻ മനസ്സിലാക്കി. ആ വസ്തു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l003": {
  "bbox": [
   692,
   1222,
   571,
   36
  ],
  "text": "ത സ്പഷ്ടമായി ഗ്രഹിക്കണം. എന്നിട്ടു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l004": {
  "bbox": [
   691,
   1254,
   578,
   47
  ],
  "text": "വേണം ഭാവിപരിപാടി ക്രമപ്പെടുത്ത",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l005": {
  "bbox": [
   689,
   1298,
   579,
   40
  ],
  "text": "വാൻ. അതിനു പറ്റിയ വിദ്യ! \"നീ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l006": {
  "bbox": [
   690,
   1340,
   574,
   37
  ],
  "text": "ദൈവപുത്രനാണെങ്കിൽ, ഈ കല്ലുകൾ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l007": {
  "bbox": [
   690,
   1379,
   571,
   38
  ],
  "text": "അപ്പമാകാൻ കല്പിക്കുക.\" എത്ര നല്ല",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l008": {
  "bbox": [
   688,
   1418,
   574,
   40
  ],
  "text": "കാര്യം! മരുഭൂമിയിൽ വെച്ചു് വിശന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l009": {
  "bbox": [
   687,
   1458,
   577,
   38
  ],
  "text": "പൊരിഞ്ഞു് മരിക്കേണ്ട ആവശ്യമില്ല.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l010": {
  "bbox": [
   688,
   1498,
   578,
   38
  ],
  "text": "കല്ലിനെ അപ്പമാക്കാൻ കഴിവുണ്ടു് ദൈ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l011": {
  "bbox": [
   688,
   1540,
   573,
   33
  ],
  "text": "വപുത്രനാണെങ്കിൽ. പിശാചിന്റെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r21_l012": {
  "bbox": [
   688,
   1577,
   401,
   36
  ],
  "text": "സൂത്രം അതിഭയങ്കരം തന്നെ.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r22_l001": {
  "bbox": [
   690,
   1659,
   575,
   38
  ],
  "text": "ഇപ്പോൾ വിശപ്പടക്കാൻ. ഒന്നുകിൽ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r22_l002": {
  "bbox": [
   686,
   1697,
   578,
   37
  ],
  "text": "മലയിറങ്ങി നാട്ടിൽ പോയി ഭക്ഷണംക",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r22_l003": {
  "bbox": [
   690,
   1739,
   573,
   33
  ],
  "text": "ഴിക്കാം. അല്ലെങ്കിൽ ദൈവത്തെ ത്തന്നെ അ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r22_l004": {
  "bbox": [
   691,
   1775,
   573,
   40
  ],
  "text": "ദിനു പ്രതിവിധിയുണ്ടാക്കാം. പരീശ്രു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r23_l001": {
  "bbox": [
   768,
   1860,
   397,
   53
  ],
  "text": "സ്വപ്നപണയം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r23_l002": {
  "bbox": [
   696,
   1923,
   544,
   38
  ],
  "text": "കുറഞ്ഞപലിശ. കൂടുതൽ നിരക്കു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l001": {
  "bbox": [
   1286,
   1151,
   1178,
   38
  ],
  "text": "ല്ലാം വിപ്പവങ്ങൾ ഏജന്റന്മാർമുഖേന \"മൂശ നാല്പതുദിവസം ഉപവസിച്ചു.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l002": {
  "bbox": [
   1287,
   1182,
   580,
   47
  ],
  "text": "അവൻ നാട്ടിൽ നടത്തുന്ന! ഭക്ഷ്യക്ഷാമ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l003": {
  "bbox": [
   1287,
   1225,
   576,
   39
  ],
  "text": "ത്തെ പരിഹരിക്കാൻ സാധനങ്ങൾ ധ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l004": {
  "bbox": [
   1287,
   1265,
   580,
   40
  ],
  "text": "രാളം ഉണ്ടാക്കുന്നതിനുപകരം ഉള്ളതി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l005": {
  "bbox": [
   1286,
   1301,
   584,
   47
  ],
  "text": "നെ നശിപ്പിക്കുകയോ ഉണ്ടാകുന്നതി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r24_l006": {
  "bbox": [
   1288,
   1349,
   1156,
   39
  ],
  "text": "നെ തടസ്സപ്പെടുത്തുകയോ ചെയ്യുന്നു. \"കൊള്ളാം. പിന്നെ, റോസലീൻ!\"",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r25_l001": {
  "bbox": [
   1322,
   1428,
   539,
   33
  ],
  "text": "ഭോജനപ്രിയംകരണം വന്ന ശിക്ഷ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r25_l002": {
  "bbox": [
   1288,
   1466,
   572,
   36
  ],
  "text": "യാണു് പഞ്ഞം. തക്കമില്ല. തിന്നാൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r25_l003": {
  "bbox": [
   1286,
   1508,
   573,
   37
  ],
  "text": "ധാരാളമുണ്ടായപ്പോൾ തിന്നുകുടിച്ചു് മ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r26_l001": {
  "bbox": [
   1288,
   1582,
   572,
   41
  ],
  "text": "ൻറെ ശിക്ഷ, ഇന്നു തിന്നാനില്ല. നീർ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l001": {
  "bbox": [
   1286,
   1663,
   576,
   39
  ],
  "text": "നോക്കാൻ ഇന്നു മന്ത്രിമാരും പ്രസംഗി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l002": {
  "bbox": [
   1286,
   1702,
   114,
   28
  ],
  "text": "ക്കുന്നു!!",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l003": {
  "bbox": [
   1328,
   1744,
   532,
   36
  ],
  "text": "ചിലർക്കു് ഇന്നും പട്ടിണിയില്ല; ശ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l004": {
  "bbox": [
   1288,
   1783,
   572,
   36
  ],
  "text": "രീരന്നെ. അവരങ്ങനെ സുഖിച്ചു് ഉറ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l005": {
  "bbox": [
   1288,
   1819,
   575,
   39
  ],
  "text": "ങ്ങുകയാണു്. അവരുടെ ദിവസം അവർ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r27_l006": {
  "bbox": [
   1288,
   1863,
   573,
   35
  ],
  "text": "ക്കം വരും. അവരെയു ഓർക്കുന്നില്ല. എ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r28_l001": {
  "bbox": [
   1292,
   1945,
   553,
   19
  ],
  "text": "",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r29_l001": {
  "bbox": [
   1705,
   1353,
   159,
   30
  ],
  "text": "ചെയ്യുന്നു.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r30_l001": {
  "bbox": [
   1891,
   1196,
   374,
   32
  ],
  "text": "അതിനെ അനുകരിച്ചു്.\"",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r30_l002": {
  "bbox": [
   1928,
   1230,
   495,
   37
  ],
  "text": "\"കൊള്ളാം. പിന്നെ, ജെയിംസ്!\"",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r30_l003": {
  "bbox": [
   1928,
   1270,
   537,
   40
  ],
  "text": "“ഇസ്രായേൽജനങ്ങൾ നാല്പതുകൊല്ലം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r30_l004": {
  "bbox": [
   1885,
   1307,
   540,
   44
  ],
  "text": "മരുഭൂമിയിൽ കറങ്ങി. അതുകൊണ്ടു്.”",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r31_l001": {
  "bbox": [
   1924,
   1392,
   534,
   35
  ],
  "text": "“പറയൂ ……ഒരു കുട്ടിക്കു് അറിയാൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r31_l002": {
  "bbox": [
   1888,
   1428,
   575,
   39
  ],
  "text": "പാടില്ലെന്നു കരുതി മറ്റുള്ളവർ ചിരി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r31_l003": {
  "bbox": [
   1889,
   1465,
   572,
   49
  ],
  "text": "ക്കുന്നതു് ഭംഗിയല്ല ... ഇനി വല്ലതും അ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r31_l004": {
  "bbox": [
   1888,
   1504,
   575,
   47
  ],
  "text": "റിയാവുന്നവർ കൈ പൊക്കു് ... ആരുമി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r31_l005": {
  "bbox": [
   1886,
   1549,
   579,
   39
  ],
  "text": "ല്ല ... ഏലിയാസു് ദീർഘദർശി നാല്പതു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l001": {
  "bbox": [
   79,
   1968,
   572,
   36
  ],
  "text": "ദിവസം ഉപവസിച്ചുകൊണ്ടാണു് ക്രൂപവൽ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l002": {
  "bbox": [
   79,
   2008,
   572,
   35
  ],
  "text": "കരിയെന്നുമ്പ് അവരുടെ ജീവിതത്തിൽ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l003": {
  "bbox": [
   79,
   2047,
   574,
   35
  ],
  "text": "ഏകാദശവും മിശിഹായുമാണു്. അതി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l004": {
  "bbox": [
   79,
   2088,
   571,
   32
  ],
  "text": "നാൽ ഓരോ കത്തോലിക്കാ വിദ്യാലയ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l005": {
  "bbox": [
   73,
   2128,
   580,
   36
  ],
  "text": "ത്തും നമ്മുടെ രക്ഷാസന്ദേശങ്ങളായി നാം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l006": {
  "bbox": [
   75,
   2167,
   575,
   38
  ],
  "text": "പരിഗണിച്ചു പ്രോത്സാഹിപ്പിക്കേണ്ട",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l007": {
  "bbox": [
   77,
   2215,
   97,
   25
  ],
  "text": "തത്രെ.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l008": {
  "bbox": [
   112,
   2248,
   539,
   35
  ],
  "text": "അമിനാൾ ബ. സഹോദരരേ, പ്രി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l009": {
  "bbox": [
   77,
   2285,
   574,
   39
  ],
  "text": "യമക്കളേ, നാം സമ്മേളിച്ചിരിക്കുന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l010": {
  "bbox": [
   72,
   2324,
   577,
   41
  ],
  "text": "ഈ പ്രസ്ഥാനത്തെ ഉള്ളിഞ്ഞു സഹാ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l011": {
  "bbox": [
   71,
   2368,
   575,
   35
  ],
  "text": "യിക്കണമെന്നു് ഒന്നുകൂടി അഭ്യർത്ഥിക്ക",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l012": {
  "bbox": [
   77,
   2409,
   571,
   32
  ],
  "text": "ന. നിങ്ങളെ ഓരോരുത്തരെയും കണ്ടു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l013": {
  "bbox": [
   72,
   2445,
   575,
   38
  ],
  "text": "നിങ്ങളോടു് ഈ വിഷയത്തെപ്പറ്റി സം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l014": {
  "bbox": [
   70,
   2485,
   577,
   36
  ],
  "text": "സാരിക്കണമെന്നു് നമുക്കു് ആഗ്രഹം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l015": {
  "bbox": [
   73,
   2517,
   2349,
   53
  ],
  "text": "ണ്ടു്. അതിനു് ഇന്നു് നമുക്ക സാധ്യമ വ്യശക്തി പ്രകാശിപ്പിക്കാൻ ഈശോ പ്രൊപ്രൈറ്റർ & മാനേജർ സി. ജെ. ജോസഫു്, വായ്പൂരു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l016": {
  "bbox": [
   75,
   2562,
   2377,
   53
  ],
  "text": "ല്ല. അതിനാൽ ഈ അഭ്യർത്ഥനയെ അ തള്ളാറായില്ല. പരിപൂർണ്ണമായി ദൈവപ Artist T. P. Joseph",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l017": {
  "bbox": [
   77,
   2607,
   571,
   32
  ],
  "text": "ർഹിക്കുന്ന ഗൗരവത്തോടെ സ്വീകരി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l018": {
  "bbox": [
   73,
   2668,
   2385,
   50
  ],
  "text": "ങ്ങൾ പാടുള്ളവിധം സഹായിക്കുവിൻ. ജീവിക്കുന്നതു്. പിന്നെയും ദൈവവദ ല്ലാവരും പട്ടിണിക്കാരായാൽ പട്ടിണി കനെ ലോകം നാല്പതു നൂറ്റാണ്ടു് പ്രതി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l019": {
  "bbox": [
   112,
   2725,
   534,
   36
  ],
  "text": "ഇന്നത്തെ ദുഃഖദുഷ്ടമായ സ്ഥിതിവി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l020": {
  "bbox": [
   70,
   2764,
   575,
   39
  ],
  "text": "തികൾ ഭേദപ്പെടുത്തുന്നതിനു് പരിശ്രമ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l021": {
  "bbox": [
   71,
   2786,
   2385,
   53
  ],
  "text": "കന്യകാമാതാവിന്റെ മാധ്യസ്ഥം ലഭി ഈ അരുളപ്പാടു കേട്ടു്. ദൈവം അവരെ വെറുതെവിട്ടിരിക്കുന്ന നാല്പതുദിവസം തപസ്സുചെയ്ത. ഈശോ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l022": {
  "bbox": [
   71,
   2826,
   2385,
   54
  ],
  "text": "ക്കവാൻ ഒക്ടോബർ മാസംമുഴുവനും കൂട ഈ മറുപടി നല്ലൊടിയായിരുന്നു തു്. ഉയിർത്തിട്ടു് നാല്പതു ദിവസം അപ്പസ്തോ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l023": {
  "bbox": [
   72,
   2881,
   572,
   40
  ],
  "text": "തൽ ഭക്തിയോടുകൂടി അനുഷ്ഠിക്കണമെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l024": {
  "bbox": [
   71,
   2907,
   2382,
   50
  ],
  "text": "നു് സെപ്റ്റംബർ 15-ാം തീയതിയിലെ ഒരു ഗ്രഹം ശീഘ്രമായി. ഒന്നാമതെ സമ ങ്ങളാൽ ആവുന്നതു് ചെയ്യണം. അപ്പം സ്വർഗ്ഗാരോഹണം ചെയ്തതു്. ഒരു പ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l025": {
  "bbox": [
   73,
   2964,
   567,
   34
  ],
  "text": "ചാക്രികലേഖനത്തിൽ ഭാഗ്യമോടെ ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l026": {
  "bbox": [
   70,
   3003,
   575,
   38
  ],
  "text": "മ്മെ ഭരിക്കുന്ന പന്ത്രണ്ടാംപീയൂസു് മാർ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l027": {
  "bbox": [
   69,
   3037,
   574,
   50
  ],
  "text": "പ്പാപ്പാ ആവശ്യപ്പെട്ടിരിക്കുന്ന. കൊന്ത",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r32_l028": {
  "bbox": [
   68,
   3082,
   574,
   39
  ],
  "text": "നമസ്കാരത്തിന്റെ പ്രാധാന്യത്തെ ഉ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l001": {
  "bbox": [
   69,
   3164,
   567,
   33
  ],
  "text": "ന്നു: “ലോകത്തിന്റെ ദുരവസ്ഥ ഇന്നു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l002": {
  "bbox": [
   71,
   3199,
   2382,
   42
  ],
  "text": "ഏത്ര കണ്ടു കഠിനമാണോ അത്ര കണ്ടു ക്ഷ ത്തു പ്രഖ്യാപിച്ചു. അത്യാത്മികതകൊണ്ടു് ആ സാധനങ്ങളോ കടം ഇന്നതു്. തന്നെ അടുത്ത ദിവസത്തെക്കു് — ഈശോ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l003": {
  "bbox": [
   68,
   3239,
   2381,
   42
  ],
  "text": "ഉതൽ ഭക്തിയോടുകൂടെ ഇക്കൊല്ലം കൊ ദവും അതുവഴി മനുഷ്യവംശമുഴുവനും പി തുതന്നെ മിതമായി. ഈശോയെ ഓർത്തു യെ രണ്ടാമത്തെ ആദം എന്ന വിളിക്ക",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l004": {
  "bbox": [
   70,
   3282,
   572,
   36
  ],
  "text": "ന്തനമസ്കാരം നടത്തണമെന്നു് നാം ആ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l005": {
  "bbox": [
   65,
   3318,
   2386,
   42
  ],
  "text": "ഗ്രഹിക്കുന്നു. പരിശുദ്ധ പിതാവിന്റെ ത്രം പ്രദർശിപ്പിച്ചു് ഈശോ അവനെ ടിക്കു് അവൻ ചിരിക്കാനിയൽ പിറുപിറ എന്നു്, സ്വന്തം കൊച്ചച്ചൻ.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l006": {
  "bbox": [
   64,
   3360,
   574,
   37
  ],
  "text": "ഈ ഉൾബോധനമനുസരിച്ചു കൊന്ത",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l007": {
  "bbox": [
   64,
   3399,
   574,
   38
  ],
  "text": "നമസ്കാരം ക്രമമായും ദിവസന്തോറും ഭ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l008": {
  "bbox": [
   66,
   3440,
   2387,
   42
  ],
  "text": "കതിടയാടുകളുടെ നിങ്ങൾ നടത്തുവിൻ. ഡിപ്പിക്കപ്പെട്ടവയാണു്. നിങ്ങളുള്ള കാ ഗിക്കണം. മറ്റുള്ളവർ ഭോജനപ്രിയത്താ കഴിഞ്ഞലക്കം 11-ാം പേജിൽ കൊ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l009": {
  "bbox": [
   68,
   3477,
   2386,
   42
  ],
  "text": "കേരളത്തിലെ പ്രസ്ഥാനത്തിന്റെ വിജയത്തി ണ്ണെന്നില്ലേ? കേൾക്കന്നില്ലേ? അറിയൂ ടും മദ്യപാനത്തിലും ഈശോയെ ഉപ ട്ടത്തിന്ന “പുനഃസംസ്കരണം” എന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r33_l010": {
  "bbox": [
   66,
   3519,
   2385,
   38
  ],
  "text": "നായിക്കൂടി ഒക്ടോബർമാസത്തിലെ പ്ര ന്നില്ല? ഓഷൻകാലം! ഭക്ഷണസന്ധ്യ വിക്കന്നില്ലേ? അതിന പരിഹാരമായി വാർത്തയിലെ “നമ്മുടെ പിതാക്കന്മാരുടെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r34_l001": {
  "bbox": [
   820,
   1972,
   335,
   44
  ],
  "text": "ബാങ്ക് ഓഫ്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r34_l002": {
  "bbox": [
   756,
   2024,
   437,
   68
  ],
  "text": "കൊച്ചിൻ ക്ലിപ്പം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r34_l003": {
  "bbox": [
   866,
   2099,
   212,
   32
  ],
  "text": "എറണാകുളം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r34_l004": {
  "bbox": [
   767,
   2133,
   416,
   39
  ],
  "text": "മളാഞ്ചേരി, ചാലക്കുടി, തൃശ്ശൂർ,",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r34_l005": {
  "bbox": [
   801,
   2172,
   334,
   35
  ],
  "text": "വില്ലിങ്ങ്ടൺ ഐലന്റ്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l001": {
  "bbox": [
   681,
   2248,
   573,
   39
  ],
  "text": "ഭാര്യപീയാണു് ഈശോയെ വിജനപ്ര",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l002": {
  "bbox": [
   679,
   2285,
   577,
   44
  ],
  "text": "ദേശത്തേക്കു നയിച്ചതെന്നു് സുവിശേഷ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l003": {
  "bbox": [
   681,
   2329,
   572,
   33
  ],
  "text": "കന്മാർ പറയുന്നു. ഇങ്ങനെയിരിക്കെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l004": {
  "bbox": [
   682,
   2362,
   572,
   49
  ],
  "text": "പിശാചിന്റെ ഉപദേശം കേട്ടു് അത്തു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l005": {
  "bbox": [
   676,
   2398,
   581,
   57
  ],
  "text": "ഭം പ്രവർത്തിക്കുന്നതു് ശരിയല്ല. നിസ്സാ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l006": {
  "bbox": [
   681,
   2443,
   573,
   42
  ],
  "text": "മായ ഒരു കാര്യത്തിനുവേണ്ടി, അതും",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r35_l007": {
  "bbox": [
   677,
   2487,
   576,
   35
  ],
  "text": "സ്വന്തം സൗകര്യത്തിനുവേണ്ടി സ്വാ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l001": {
  "bbox": [
   680,
   2608,
   573,
   33
  ],
  "text": "രീപാലനയിൽ അവിടുന്നു വിശ്വാസി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l002": {
  "bbox": [
   679,
   2647,
   568,
   37
  ],
  "text": "ച്ചു: “അപ്പംകൊണ്ടു മാത്രമല്ല മനുഷ്യൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l003": {
  "bbox": [
   675,
   2686,
   574,
   35
  ],
  "text": "ജീവിക്കുന്നതു്. പിന്നെയും ദൈവവദ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l004": {
  "bbox": [
   675,
   2726,
   572,
   35
  ],
  "text": "നത്തിൽനിന്നു വരുന്ന ഓരോ വചനം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l005": {
  "bbox": [
   675,
   2768,
   574,
   33
  ],
  "text": "കൊണ്ടുമാണു്.” പിശാചു് ഒന്നു തെറ്റി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l006": {
  "bbox": [
   675,
   2808,
   340,
   34
  ],
  "text": "ഈ അരുളപ്പാടു കേട്ടു്.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l007": {
  "bbox": [
   710,
   2844,
   538,
   41
  ],
  "text": "ഈ മറുപടി നല്ലൊടിയായിരുന്നു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l008": {
  "bbox": [
   675,
   2886,
   571,
   33
  ],
  "text": "ആ വികടബുദ്ധിയാൽ. അവൻറെ ആ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l009": {
  "bbox": [
   675,
   2926,
   571,
   33
  ],
  "text": "ഗ്രഹം ശീഘ്രമായി. ഒന്നാമതെ സമ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l010": {
  "bbox": [
   675,
   2965,
   507,
   36
  ],
  "text": "മേഘം മുഴുവൻ അവനു നഷ്ടപ്പെട്ടു.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l011": {
  "bbox": [
   709,
   3006,
   538,
   36
  ],
  "text": "സൃഷ്ടാവായുള്ള സമത്വം മോഹിച്ചു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l012": {
  "bbox": [
   673,
   3045,
   573,
   35
  ],
  "text": "വിപക്വപ്പെട്ട കനി അത്യാത്തിയോടെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l013": {
  "bbox": [
   673,
   3084,
   574,
   38
  ],
  "text": "ആദം തിന്നു. എന്നാൽ സ്രഷ്ടാവിന്റെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l014": {
  "bbox": [
   675,
   3125,
   571,
   36
  ],
  "text": "പ്രീതി മോഹിച്ചു് കല്ലിൽനിന്നുള്ള അ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r36_l015": {
  "bbox": [
   673,
   3165,
   574,
   39
  ],
  "text": "പ്പത്തെ പൂർണ്ണമനസ്സോടെ ഈശോ വെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r37_l001": {
  "bbox": [
   669,
   3283,
   578,
   36
  ],
  "text": "ശാപത്തിനു അടിമയായി. ആത്തിരോഹി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r38_l001": {
  "bbox": [
   669,
   3366,
   460,
   32
  ],
  "text": "അമർച്ചചെയ്തു.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r38_l002": {
  "bbox": [
   708,
   3404,
   537,
   33
  ],
  "text": "ഉദരംനിമിത്തം ഇന്നും ലോകം പി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r39_l001": {
  "bbox": [
   1307,
   1992,
   536,
   75
  ],
  "text": "St. Joseph’s Art Studio",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r39_l002": {
  "bbox": [
   1324,
   2079,
   497,
   58
  ],
  "text": "ഓർഫനേജ്, തോപ്പു്, തൃശ്ശൂർ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r40_l001": {
  "bbox": [
   1277,
   2378,
   581,
   41
  ],
  "text": "അൾത്താര, സക്രാരി, സിംഹാസനം എ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r40_l002": {
  "bbox": [
   1277,
   2417,
   579,
   41
  ],
  "text": "ന്നിവകളും വ്യാസങ്ക്രമേറും ഇവിടെ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r40_l003": {
  "bbox": [
   1280,
   2462,
   327,
   34
  ],
  "text": "ചെയ്തുകൊണ്ടിരിക്കുന്നുണ്ടു്.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r41_l001": {
  "bbox": [
   1278,
   2691,
   573,
   34
  ],
  "text": "ല്ലാവരും പട്ടിണിക്കാരായാൽ പട്ടിണി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r41_l002": {
  "bbox": [
   1278,
   2730,
   571,
   32
  ],
  "text": "യുടെ കാഠിന്യം കുറഞ്ഞേക്കാം. അതു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r41_l003": {
  "bbox": [
   1277,
   2768,
   409,
   38
  ],
  "text": "കൊണ്ടുകൂടെ ആയിരിക്കാം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r41_l004": {
  "bbox": [
   1276,
   2811,
   575,
   32
  ],
  "text": "ദൈവം അവരെ വെറുതെവിട്ടിരിക്കുന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l001": {
  "bbox": [
   1311,
   2890,
   538,
   32
  ],
  "text": "ഈ ശിക്ഷ ഒന്നു നീങ്ങിക്കിട്ടാൻ നീ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l002": {
  "bbox": [
   1276,
   2930,
   573,
   33
  ],
  "text": "ങ്ങളാൽ ആവുന്നതു് ചെയ്യണം. അപ്പം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l003": {
  "bbox": [
   1277,
   2967,
   572,
   38
  ],
  "text": "കൊണ്ടു മാത്രമല്ല മനുഷ്യൻ ജീവിക്കുന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l004": {
  "bbox": [
   1275,
   3006,
   572,
   39
  ],
  "text": "തു്. അപ്പത്തിനായിട്ടുമല്ല. അതിനാൽ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l005": {
  "bbox": [
   1273,
   3047,
   576,
   36
  ],
  "text": "തിന്നുന്നതിലും കുടിക്കുന്നതിലും ചില",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l006": {
  "bbox": [
   1273,
   3086,
   578,
   35
  ],
  "text": "ചിട്ടകൾ നമുക്കു് വേണം. ആത്തീപി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l007": {
  "bbox": [
   1271,
   3126,
   578,
   37
  ],
  "text": "ടിച്ചു് ഒന്നും തിന്നരുതു്. ഒരിക്കലും പല",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r42_l008": {
  "bbox": [
   1271,
   3166,
   582,
   39
  ],
  "text": "ഹാരങ്ങളോ, കൂട്ടാനോ, മറ്റു തീറ്റി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r43_l001": {
  "bbox": [
   1271,
   3283,
   576,
   39
  ],
  "text": "കൊണ്ടു് ഭക്ഷിക്കുക. ഭക്ഷ്യസാധനങ്ങ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r44_l001": {
  "bbox": [
   1272,
   3367,
   577,
   30
  ],
  "text": "രുക്കരുതു്. അമ്മയോടും മറ്റും രണ്ടുകൂട്ടു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r44_l002": {
  "bbox": [
   1272,
   3406,
   577,
   34
  ],
  "text": "കയ്യമരുതു്. ത്യാഗപൂർവ്വം അവ ഉപയോ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l001": {
  "bbox": [
   1461,
   2145,
   398,
   32
  ],
  "text": "ഈ സ്ഥാപനത്തിൽ മരം,",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l002": {
  "bbox": [
   1461,
   2177,
   404,
   46
  ],
  "text": "മണ്ണു്, പ്ലാസ്റ്റർ, സിമന്റു്,",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l003": {
  "bbox": [
   1462,
   2223,
   398,
   36
  ],
  "text": "ഇവകൾകൊണ്ടു എഴു വിധ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l004": {
  "bbox": [
   1462,
   2261,
   398,
   35
  ],
  "text": "അതിലുള്ള തിരുസ്വരൂപങ്ങ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l005": {
  "bbox": [
   1461,
   2301,
   398,
   37
  ],
  "text": "ളും സിമന്റു് (ചീപ്പ്സ്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r45_l006": {
  "bbox": [
   1461,
   2341,
   398,
   36
  ],
  "text": "വർക്ക്സു്) മരം ഇവകൾകൊണ്ടു",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r46_l001": {
  "bbox": [
   1928,
   2347,
   528,
   34
  ],
  "text": "ബ. അൽഫോൻസാമ്മയുടെ മനോമം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r46_l002": {
  "bbox": [
   1887,
   2387,
   581,
   37
  ],
  "text": "ഗുണത്താൽ ലഭിച്ചുകൊണ്ടിരിക്കുന്ന അ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r46_l003": {
  "bbox": [
   1884,
   2426,
   574,
   39
  ],
  "text": "നുഗ്രഹങ്ങൾക്കും, ഉദ്ദിഷ്ടകാര്യം സാധി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r46_l004": {
  "bbox": [
   1885,
   2462,
   397,
   46
  ],
  "text": "ച്ചുകിട്ടുന്നതിനും കൃതജ്ഞത.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r47_l001": {
  "bbox": [
   1885,
   2706,
   571,
   34
  ],
  "text": "ക്ഷിച്ചിരുന്നു. നിനീവേക്കാർ യോനാ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r47_l002": {
  "bbox": [
   1882,
   2743,
   576,
   41
  ],
  "text": "സു് ദീർഘദർശിയുടെ പ്രസംഗം കേട്ടു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r48_l001": {
  "bbox": [
   1877,
   2860,
   580,
   46
  ],
  "text": "ലന്മാരെ പഠിപ്പിച്ചതിനുശേഷമാണു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r49_l001": {
  "bbox": [
   1876,
   2943,
   580,
   39
  ],
  "text": "ക്ഷേ, ഉയിർപ്പിനേയും സ്വർഗ്ഗാരോഹണ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r49_l002": {
  "bbox": [
   1878,
   2984,
   578,
   34
  ],
  "text": "ത്തേയും സൂചിപ്പിക്കാനായിരിക്കാം നം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r49_l003": {
  "bbox": [
   1880,
   3022,
   593,
   38
  ],
  "text": "ല്പതുദിവസം അവിടുന്നു് ഉപവസിച്ച",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r49_l004": {
  "bbox": [
   1878,
   3063,
   571,
   38
  ],
  "text": "തു്. അതിന്റെ മുന്നറിയിപ്പുകൾ മറ്റുള്ള",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r49_l005": {
  "bbox": [
   1878,
   3104,
   206,
   28
  ],
  "text": "സംഭവങ്ങൾ.”",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r50_l001": {
  "bbox": [
   1877,
   3277,
   273,
   36
  ],
  "text": "ന്നതെന്തുകൊണ്ടു്?",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r51_l001": {
  "bbox": [
   2014,
   3385,
   264,
   44
  ],
  "text": "തിരുത്തു്",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r52_l001": {
  "bbox": [
   64,
   3558,
   2392,
   40
  ],
  "text": "ത്യേക പ്രാർത്ഥനകൾ നിങ്ങൾ കാഴ്ചവ ങ്ങൾ വേണ്ടെത്ര ഇല്ല. എത്ര നാല്പതുകാല ഈ ചെറുത്യാഗങ്ങൾ നിങ്ങൾ ചെയ്യുമെ വിശ്വാസം” എന്ന പ്രസിദ്ധഗ്രന്ഥത്തി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l001": {
  "bbox": [
   102,
   3640,
   2369,
   40
  ],
  "text": "ദൈവത്തിന്റെ കൂടുതൽ മഹത്വത്തെ സ്ത്രീമക്കും കൃഷിവകപ്പുകൾക്കു ഉത്തരമി ത്രമല്ല മനുഷ്യർ ജീവിക്കുന്നതു്.” ഇതെല്ലാം ന ഭാഗത്തിൽ “പ്രസിദ്ധഗ്രന്ഥത്തി",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l002": {
  "bbox": [
   62,
   3680,
   2390,
   35
  ],
  "text": "മാത്രാ ലാക്കാക്കിയുള്ള നമ്മുടെ പ്രസ്ഥാന ല്ല. ഈ ദീർഘവസ്ഥിയെ പിശാചു് ശ്ലേഷം ഓർത്തുകൊള്ളുക. ന്റെ” എന്നതിനപകരം “പ്രസിദ്ധം",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l003": {
  "bbox": [
   63,
   3718,
   2388,
   40
  ],
  "text": "നത്തെ അനുഗ്രഹിക്കുവാൻ നമ്മുടെ അ വേണ്ടപോലെ ഉപയോഗപ്പെടുത്തുന്ന * * * ത്തിന്റെ” എന്ന തീരുത്തിവായിക്ക",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l004": {
  "bbox": [
   62,
   3759,
   2392,
   38
  ],
  "text": "മുടെ നിമ്മ്യഹൃദയത്തോളം തിരുസഭ ണ്ടു്. ഈശോയോടു് തൊറ്റതിന്റെ പക “ഈശോ നാല്പതുദിവസം ഉപവസി ണം. ഈ പേരിലുള്ള പ്രസിദ്ധഗ്രന്ഥ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l005": {
  "bbox": [
   62,
   3800,
   2385,
   33
  ],
  "text": "യുടെ സാക്ഷകനായ വിശുദ്ധ യൗസേ വിട്ടൻ പറഞ്ഞ അവസരം. ഭക്ഷണ ച്ചതിന്റെ കാരണം കണ്ടുപിടിച്ചേ, ങ്ങിന്റെ കത്തോലിക്കർ കാർഡിനൽ ഗിബ്ബ",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r53_l006": {
  "bbox": [
   61,
   3834,
   527,
   46
  ],
  "text": "പ്പിനോടും പ്രാർത്ഥിക്കുന്നു.",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r54_l001": {
  "bbox": [
   667,
   3840,
   575,
   35
  ],
  "text": "ത്തെ പ്രതി; ഓരോ ദിവസത്തെ ചൊല്ലി; എന്തെന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p002_r55_l001": {
  "bbox": [
   1876,
   3841,
   227,
   29
  ],
  "text": "ർസു് ആണു്.",
  "model": "Claude Sonnet 5.5"
 }
}

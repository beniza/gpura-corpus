{
 "p015_r01_l001": {
  "bbox": [
   135,
   179,
   1497,
   90
  ],
  "text": "കാലത്തു് സ്കൂളിൽ പോകത്തക്കവിധം തിരിച്ചെത്തുകയും",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l002": {
  "bbox": [
   135,
   272,
   1498,
   91
  ],
  "text": "ചെയ്യും. അങ്ങനെ ഗ്രാൻറാം സ്കൂളിലെ പഠിത്തം",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l003": {
  "bbox": [
   134,
   368,
   345,
   76
  ],
  "text": "സമാരംഭിച്ചു.",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l004": {
  "bbox": [
   295,
   493,
   1343,
   96
  ],
  "text": "ന്യൂട്ടൻ താമസിച്ചിരുന്ന വീട്ടിൽ മച്ചിൻപുറത്തുള്ള",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l005": {
  "bbox": [
   135,
   589,
   1503,
   74
  ],
  "text": "ഒരൊഴിഞ്ഞ മുറിയിൽ മി. ക്ലാക്ക് കുറേ പുസ്തകം സൂക്ഷി",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l006": {
  "bbox": [
   138,
   684,
   1501,
   86
  ],
  "text": "ച്ചിരുന്നു. ആ വീട്ടിൽ ന്യൂട്ടനു് ഏറ്റവും പ്രിയമായ സ്ഥലം",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l007": {
  "bbox": [
   136,
   772,
   1499,
   85
  ],
  "text": "ഇതായിരുന്നു. അയാൾ ക്ലാസ്സിലെ പാഠങ്ങൾ പഠിക്കുന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l008": {
  "bbox": [
   137,
   869,
   1501,
   73
  ],
  "text": "തിലും വളരെ കൂടുതലായ ജാഗ്രത ഈ പുസ്തകങ്ങൾ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l009": {
  "bbox": [
   136,
   959,
   1499,
   82
  ],
  "text": "വായിച്ചു മനസ്സിലാക്കുന്ന കാര്യത്തിൽ പ്രദർശിപ്പിച്ചു.",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l010": {
  "bbox": [
   139,
   1052,
   1499,
   81
  ],
  "text": "ആദ്യത്തെ ഒന്നു രണ്ടു കൊല്ലം അയാൾ ക്ലാസ്സിലെ താഴ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l011": {
  "bbox": [
   137,
   1139,
   1501,
   64
  ],
  "text": "ത്തെ സ്ഥാനങ്ങളിൽത്തന്നെ ഒരു സ്ഥിരക്കാരനെന്നോണം",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l012": {
  "bbox": [
   138,
   1232,
   1501,
   77
  ],
  "text": "കഴിച്ചുകൂട്ടി. എന്നാൽ അചിരേണ ഐസക്കിനെ ഇപ്ര",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l013": {
  "bbox": [
   140,
   1326,
   1502,
   78
  ],
  "text": "കാരമുള്ള അനാസ്ഥയിൽ നിന്നു പിന്തിരിപ്പിക്കുവാൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l014": {
  "bbox": [
   139,
   1417,
   1501,
   82
  ],
  "text": "ഒരു സംഭവമുണ്ടായി. ഒടുവിൽ മനസ്സിനു മാററം വര",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l015": {
  "bbox": [
   141,
   1517,
   1501,
   75
  ],
  "text": "ത്താൻ ഹേതുവാക്കിയെങ്കിലും ആദ്യം ദേഹത്തെ മാത്രം",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l016": {
  "bbox": [
   139,
   1609,
   1503,
   80
  ],
  "text": "സ്പർശിച്ച ഒരു സംഭവം. ഒരു ദിവസം ക്ലാസ്സിലെ ഒന്നാമ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l017": {
  "bbox": [
   141,
   1701,
   1500,
   80
  ],
  "text": "നായിരുന്ന കുട്ടി ഐസക്കിനെ ഒന്നു തൊഴിച്ചു. അവൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l018": {
  "bbox": [
   139,
   1791,
   1506,
   77
  ],
  "text": "ഐസക്കിനെക്കാളും പ്രായവും ദേഹപുഷ്ടിയുമുള്ളവനായി",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l019": {
  "bbox": [
   140,
   1878,
   1503,
   77
  ],
  "text": "രുന്നു. എന്നാലും ഐസക്കു് അവനോടു് ഏറ്റുമുട്ടാൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l020": {
  "bbox": [
   139,
   1975,
   1507,
   83
  ],
  "text": "ക്രമൽ കാട്ടിയില്ല. അവിടത്തെ പള്ളിമുററത്തു വച്ചു്",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l021": {
  "bbox": [
   140,
   2069,
   1504,
   55
  ],
  "text": "അവർ തമ്മിൽ ഒരു ചെറിയ സമരംതന്നെ നടന്നു.",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l022": {
  "bbox": [
   139,
   2131,
   1505,
   103
  ],
  "text": "അതിൽ ഐസക്കു് വിജയിയായി എന്നുമാത്രമല്ല എതിരാ",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l023": {
  "bbox": [
   138,
   2253,
   1502,
   79
  ],
  "text": "ളിയുടെ മൂക്കു് പള്ളിമതിലിൽ ഉരച്ചു് വികൃതപ്പെടുത്തു",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l024": {
  "bbox": [
   139,
   2359,
   1502,
   77
  ],
  "text": "കയും ചെയ്തു. എന്നാൽ ഈ ജയം കൊണ്ടു മാത്രം",
  "model": "Claude Sonnet 5.5"
 },
 "p015_r01_l025": {
  "bbox": [
   141,
   2440,
   1502,
   81
  ],
  "text": "അയാൾ തൃപ്തിപ്പെട്ടില്ല. ക്ലാസ്സിലെ ഒന്നാംസ്ഥാനം കൂടി",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l001": {
  "bbox": [
   91,
   180,
   1497,
   75
  ],
  "text": "തനിക്കു് കരസ്ഥമാക്കണമെന്നു് നിശ്ചയിച്ചു്, അതിന",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l002": {
  "bbox": [
   93,
   274,
   1495,
   67
  ],
  "text": "വേണ്ടി തന്റെ പാഠങ്ങൾ ശരിക്കു പഠിക്കാൻ തുടങ്ങി.",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l003": {
  "bbox": [
   96,
   369,
   1492,
   76
  ],
  "text": "അല്പകാലത്തിനുള്ളിൽ ആ ആശയും സാധിച്ചു. ഐ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l004": {
  "bbox": [
   96,
   463,
   1494,
   85
  ],
  "text": "സക്കു് ക്ലാസ്സിൽ ഒന്നാമനായി എന്നു മാത്രമല്ല, ക്രമേണ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l005": {
  "bbox": [
   95,
   554,
   1350,
   96
  ],
  "text": "ആ സ്കൂളിലെ 'തലവൻ' ആയിത്തീരുകയും ചെയ്തു.",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l006": {
  "bbox": [
   254,
   715,
   1340,
   63
  ],
  "text": "വായനയിൽ വളരെ അഭിരുചിയുള്ളവനായിരുന്നു",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l007": {
  "bbox": [
   98,
   811,
   1511,
   90
  ],
  "text": "ന്യൂട്ടൻ. എങ്കിലും ആദ്യകാലത്തുതന്നെ തികച്ചും സ്വന്ത",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l008": {
  "bbox": [
   97,
   908,
   1496,
   68
  ],
  "text": "മായ ആശയങ്ങളും അഭിപ്രായങ്ങളും മുഖേന അയാൾ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l009": {
  "bbox": [
   99,
   998,
   1497,
   75
  ],
  "text": "തന്റെ അസാധാരണത്വം വെളിപ്പെടുത്തിയിരുന്നു.",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l010": {
  "bbox": [
   103,
   1089,
   1496,
   69
  ],
  "text": "യന്ത്രസംബന്ധമായ ഉപകരണങ്ങൾ നിർമ്മിക്കുന്നതിലും",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l011": {
  "bbox": [
   102,
   1181,
   1498,
   76
  ],
  "text": "അവയെ പ്രവർത്തിപ്പിക്കുന്നതിലും അയാൾ അതിയായ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l012": {
  "bbox": [
   105,
   1276,
   1497,
   84
  ],
  "text": "കൗതുകവും ആസക്തിയും കാട്ടി. സ്കൂൾസമയം കഴി",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l013": {
  "bbox": [
   107,
   1362,
   1495,
   84
  ],
  "text": "ഞ്ഞാൽ മറ്റു കുട്ടികളൊന്നിച്ചു് കളിക്കാൻ ഐസക്കു്",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l014": {
  "bbox": [
   104,
   1448,
   1502,
   84
  ],
  "text": "കൂട്ടാകിയില്ല. മരംകൊണ്ടുള്ള യന്ത്രമാതൃകകളും മററു",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l015": {
  "bbox": [
   107,
   1551,
   1497,
   77
  ],
  "text": "'ലൊട്ടുലൊടുക്കു'കളും നിർമ്മിക്കുന്നതിൽ അയാൾ തന്റെ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l016": {
  "bbox": [
   109,
   1644,
   1494,
   76
  ],
  "text": "സമയം ചിലവാക്കി. ആവശ്യമുള്ള പണിയായുധങ്ങളും",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l017": {
  "bbox": [
   111,
   1738,
   1496,
   97
  ],
  "text": "ആ ബാലൻ സമ്പാദിച്ചിരുന്നു; അറപ്പവാൾ, ഉളി,",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l018": {
  "bbox": [
   114,
   1835,
   1496,
   73
  ],
  "text": "ചിന്തേർ, കൊട്ടുവടി, കൈകോടാലി മുതലായവ.",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l019": {
  "bbox": [
   115,
   1926,
   1494,
   67
  ],
  "text": "ഇവയെ ഉപയോഗിക്കുന്നതിൽ അയാൾക്കു് നല്ല സാമ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l020": {
  "bbox": [
   118,
   2016,
   1126,
   132
  ],
  "text": "ർത്ഥ്യവും നിഷ്കർഷയും ഉണ്ടായിരുന്നു താനും.",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l021": {
  "bbox": [
   275,
   2171,
   1335,
   70
  ],
  "text": "ഗ്രാൻറാമിനു സമീപം ചില വേലക്കാർകൂടി ഒരു",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l022": {
  "bbox": [
   120,
   2276,
   1488,
   78
  ],
  "text": "കാററാടിയന്ത്രം ഉണ്ടാക്കുന്നതു് ന്യൂട്ടൻ കണ്ടു. അയാളും",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l023": {
  "bbox": [
   126,
   2360,
   1487,
   84
  ],
  "text": "അതിന്റെ പണി സൂക്ഷിച്ചു മനസ്സിലാക്കി. അതിന്റെ",
  "model": "Claude Sonnet 5.5"
 },
 "p016_r01_l024": {
  "bbox": [
   125,
   2449,
   1493,
   80
  ],
  "text": "മാതൃകയിൽ സ്വന്തമായി ഒരു കാററാടിയന്ത്രം നിർമ്മിച്ചു.",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l001": {
  "bbox": [
   0,
   143,
   55,
   43
  ],
  "text": "",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l002": {
  "bbox": [
   0,
   208,
   1584,
   81
  ],
  "text": "അതിനെ ക്ലാക്കിന്റെ വസതിയുടെ പുരപ്പുറത്തു സ്ഥാ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l003": {
  "bbox": [
   0,
   289,
   1585,
   95
  ],
  "text": "പിച്ചു. ആ യന്ത്രം ഭംഗിയായി കറങ്ങുന്നതു് ചുറുമുള്ള",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l004": {
  "bbox": [
   2,
   403,
   899,
   71
  ],
  "text": "ജനങ്ങൾ കണ്ടു് അത്ഭുതപ്പെട്ടു.",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l005": {
  "bbox": [
   244,
   531,
   1343,
   71
  ],
  "text": "ധാന്യങ്ങൾ പൊടിക്കാനുള്ള യന്ത്രത്തിന്റെ മാതൃ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l006": {
  "bbox": [
   0,
   607,
   1586,
   94
  ],
  "text": "കയിൽ ന്യൂട്ടൻ മറെറാരു യന്ത്രവും പണിതു. നിലങ്ങ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l007": {
  "bbox": [
   82,
   710,
   1507,
   78
  ],
  "text": "ളിൽ വെള്ളം വററിക്കാനുപയോഗിക്കുന്ന ചവിട്ടുചക്രം",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l008": {
  "bbox": [
   83,
   802,
   1504,
   70
  ],
  "text": "ഉണ്ടല്ലോ; അതുപോലുള്ള ഒരു ചക്രമായിരുന്നു ഈ യന്ത്ര",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l009": {
  "bbox": [
   84,
   893,
   1503,
   71
  ],
  "text": "ത്തിന്റെ പ്രധാനഭാഗം. കീഴ്ഭാഗത്തു് ഒരു ചുണ്ടെ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l010": {
  "bbox": [
   86,
   983,
   1499,
   81
  ],
  "text": "ലിയെ പിടിച്ചടച്ചു. മുകൾഭാഗത്തു് അല്പം ധാന്യവും",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l011": {
  "bbox": [
   85,
   1085,
   1503,
   72
  ],
  "text": "വച്ചിരുന്നു. ധാന്യത്തിന്റെ അടുക്കൽ എത്തുവാൻ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l012": {
  "bbox": [
   85,
   1172,
   1506,
   74
  ],
  "text": "എലിക്കു് ചക്രത്തിന്റെ പടികളിൽ ചവിട്ടി മേല്പോട്ട",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l013": {
  "bbox": [
   83,
   1264,
   1507,
   72
  ],
  "text": "കയറണമായിരുന്നു. അങ്ങനെ ചെയ്യുമ്പോൾ ചക്രം",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l014": {
  "bbox": [
   86,
   1355,
   1498,
   77
  ],
  "text": "തിരിയുകയും യന്ത്രം പ്രവർത്തിക്കുകയും ചെയ്യും. ചുണ്ടെ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l015": {
  "bbox": [
   89,
   1448,
   1504,
   88
  ],
  "text": "ലിയെ ന്യൂട്ടൻ തന്റെ മില്ലർ (ധാന്യം പൊടിക്കുന്നവൻ)",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l016": {
  "bbox": [
   87,
   1541,
   1508,
   86
  ],
  "text": "എന്നു വിളിച്ചു. 'പൊടിക്കാനല്പിക്കുന്ന ധാന്യം സ്വയം",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l017": {
  "bbox": [
   0,
   1632,
   1593,
   78
  ],
  "text": "തിന്നു തീർക്കുന്ന ഒരു മില്ലറാണു തന്റേതു്'' എന്നൊരു",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l018": {
  "bbox": [
   0,
   1710,
   1594,
   76
  ],
  "text": "ഫലിതവും അയാൾ പറയാറുണ്ടായിരുന്നു. ജലശക്തി",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l019": {
  "bbox": [
   0,
   1814,
   1593,
   71
  ],
  "text": "കൊണ്ടു് പ്രവർത്തിക്കുന്ന ഒരു ഘടികാരവും. അയാൾ",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l020": {
  "bbox": [
   90,
   1908,
   1500,
   78
  ],
  "text": "നിർമ്മിച്ചു. ഇതിനു് നാലടിപൊക്കവും മുൻവശത്തു്",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l021": {
  "bbox": [
   90,
   1997,
   1507,
   81
  ],
  "text": "സാധാരണരീതിയിൽ മണിക്കൂറുകളെ അടയാളപ്പെടുത്തി",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l022": {
  "bbox": [
   91,
   2092,
   1508,
   79
  ],
  "text": "ട്ടുള്ള മുഖപ്പലകയും ഉണ്ടായിരുന്നു. സൂചി തിരിഞ്ഞി",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l023": {
  "bbox": [
   89,
   2183,
   1509,
   78
  ],
  "text": "രുന്നതു് അതിനോടനു ബന്ധിച്ചിരുന്ന ഒരു കൈപ്പിടി",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l024": {
  "bbox": [
   92,
   2271,
   1501,
   74
  ],
  "text": "യിൽ വെള്ളം ധാരധാരയായി വീഴുന്നതു കൊണ്ടായിരുന്നു.",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l025": {
  "bbox": [
   0,
   2355,
   1599,
   88
  ],
  "text": "മുകൾത്തട്ടിലെ ഒരു പാത്രത്തിൽ ദിവസവും കാലത്തു്",
  "model": "Claude Sonnet 5.5"
 },
 "p017_r01_l026": {
  "bbox": [
   90,
   2465,
   1510,
   81
  ],
  "text": "വെള്ളം നിറച്ചു വയ്ക്കണം. ഈ യന്ത്രത്തിനു് ജനങ്ങൾ",
  "model": "Claude Sonnet 5.5"
 }
}

  "model": "Claude Sonnet 5.5"
 },
 "p050_r02_l003": {
  "bbox": [
   172,
   433,
   1493,
   66
  ],
  "text": "എന്ന പേരുകൾ ഇവക്കു കല്പിച്ചിരിക്കുന്നു. വിളിരൂപത്തെ",
  "model": "Claude Sonnet 5.5"
 },
 "p050_r02_l004": {
  "bbox": [
   173,
   519,
   1493,
   69
  ],
  "text": "കാണിക്കുന്ന പ്രഥമയുടെ ഭേദത്തിന്നു സംബോധന എന്നു",
  "model": "Claude Sonnet 5.5"
 },
 "p050_r02_l005": {
  "bbox": [
   173,
   610,
   1494,
   66
  ],
  "text": "പേരാകുന്നു. ‘ഓടുകൂടി’ എന്ന അത്ഥത്തെ കാണിക്കുന്ന",
  "model": "Claude Sonnet 5.5"
 },
 "p050_r02_l006": {
  "bbox": [
   169,
   695,
   1499,
   71
  ],

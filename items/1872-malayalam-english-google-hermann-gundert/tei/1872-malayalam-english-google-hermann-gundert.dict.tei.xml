        <fw type="header" facs="#p300_r01_l001"><lb facs="#p300_r01_l001"/>കുനുക-- BDH</fw>
        <entry xml:id="p300_e02" facs="#p300_r04_l001 #p300_r06_l001 #p300_r08_l001 #p300_r10_l001"><form type="lemma"><orth><lb facs="#p300_r04_l001"/>കുനുകനേ</orth><pron notation="transliteration">kunuyunē</pron></form>  <etym>(C. Te. ഗുന്ന=കറു)</etym> <sense><def xml:lang="en">Very</def> <def xml:lang="en"><lb facs="#p300_r06_l001"/>small, little.</def> <def xml:lang="en">— prh. waving, curling</def> <xr type="syn">(= കുനി)</xr> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r08_l001"/>കുന്ദുകനച്ചിന്നും കുരുൾനിര</quote><bibl>Bhr.</bibl></cit>  <cit type="example"><quote xml:lang="ml">കുടിലമായുള്ള</quote><bibl>KR,</bibl></cit> <note><lb facs="#p300_r10_l001"/>ap alg) ek</note> </sense></entry>
        <entry xml:id="p300_e03" facs="#p300_r12_l001 #p300_r14_l001 #p300_r16_l001 #p300_r18_l001 #p300_r20_l001 #p300_r22_l001 #p300_r24_l001"><form type="lemma"><orth><lb facs="#p300_r12_l001"/>കുന്തം</orth><pron notation="transliteration">kundam</pron></form>  <etym>S. (L. contus, also T. Tu. C.</etym> <etym><lb facs="#p300_r14_l001"/>Te. കുന=മുന point, √ കുത്തുക)</etym> <sense><def xml:lang="en">Lance, spear</def> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r16_l001"/>ചാട്ടുക.</quote></cit> <def xml:lang="en">javelin.</def> <cit type="example"><quote xml:lang="ml">തോക്കിന്മേൽകു.</quote></cit> <def xml:lang="en">bayonet.</def> <cit type="example"><quote xml:lang="ml">ക</quote></cit> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r18_l001"/>ന്തവും ഏന്തിപിടിച്ചുവന്നു</quote><bibl>Mud.</bibl></cit> </sense> <entry type="derived"><form><orth><lb facs="#p300_r20_l001"/>കുന്തക്കാർ</orth></form> <sense><def xml:lang="en">spearmen.</def></sense> </entry><entry type="derived"><form><orth><lb facs="#p300_r22_l001"/>കുന്തക്കാൽ</orth></form> <sense><def xml:lang="en">prop, kingpost in a reef</def> <bibl>V1.</bibl> <usg>Palg.</usg> <note><lb facs="#p300_r24_l001"/>(ടകയ്യുകാതു.</note></sense></entry><entry xml:id="p300_e04" facs="#p300_r26_l001" type="derived"><form type="lemma"><orth><lb facs="#p300_r26_l001"/>കുന്തക്കാൽ, — കൈ, — വടി</orth></form> <sense><def xml:lang="en">parts of a spear.</def></sense></entry><entry xml:id="p300_e05" facs="#p300_r28_l001" type="derived"><form type="lemma"><orth><lb facs="#p300_r28_l001"/>കുന്തപ്പയറ്റു</orth></form> <sense><def xml:lang="en">spear exercise.</def></sense></entry><entry xml:id="p300_e06" facs="#p300_r30_l001 #p300_r32_l001 #p300_r34_l001 #p300_r36_l001 #p300_r38_l001 #p300_r40_l001 #p300_r42_l001" type="derived"><form type="lemma"><orth><lb facs="#p300_r30_l001"/>കുന്തപ്പാട്ടു</orth></form> <sense><def xml:lang="en">a song at marriages</def> <usg>(loc.)</usg> <xr type="syn">also = ത</xr> <note><lb facs="#p300_r32_l001"/>sadly pg.</note></sense> <entry type="derived"><form><orth><lb facs="#p300_r34_l001"/>കുന്താണി</orth></form> <sense n="1"><lbl type="senseNumber">1.</lbl> <def xml:lang="en">mortar for beating paddy.</def></sense> <etym>T. So. C.</etym> <sense n="2"><lbl type="senseNumber"><lb facs="#p300_r36_l001"/>2.</lbl> <def xml:lang="en">handspike, lever</def> <bibl>V2.</bibl></sense> </entry><entry type="derived"><form><orth><lb facs="#p300_r38_l001"/>കുന്താലി</orth></form> <etym>(T. കുന്താളി, Palg. കുന്തളം)</etym> <sense><def xml:lang="en">pickaxe</def> <bibl><lb facs="#p300_r40_l001"/>VYyM.</bibl> <xr type="syn">or = égoelo.</xr></sense> </entry><entry type="derived"><form><orth><lb facs="#p300_r42_l001"/>കുന്തേru</orth></form> <sense><def xml:lang="en">thrust of spear, play with spears</def> <bibl>V2.</bibl></sense></entry></entry></entry>
        <entry xml:id="p300_e07" facs="#p300_r44_l001 #p300_r46_l001 #p300_r48_l001"><form type="lemma"><orth><lb facs="#p300_r44_l001"/>കുന്തളം</orth><pron notation="transliteration">kundalam</pron></form>  <etym>S. (=കൂന്തൽ)</etym> <sense><def xml:lang="en">Hair of the</def> <def xml:lang="en"><lb facs="#p300_r46_l001"/>head</def> <cit type="example"><quote xml:lang="ml">ക. ആണ്ടൊരു മുഖം</quote><bibl>CG.</bibl></cit>  <cit type="example"><quote xml:lang="ml">ചലൻ ക. etc.</quote></cit> <note>—</note></sense> <entry type="derived"><form><orth><lb facs="#p300_r48_l001"/>കുന്തലമീൻ</orth></form> <sense><def xml:lang="en">a fish</def> <bibl>V1.</bibl></sense></entry></entry>
        <entry xml:id="p300_e08" facs="#p300_r50_l001 #p300_r52_l001 #p300_r54_l001 #p300_r56_l001"><form type="lemma"><orth><lb facs="#p300_r50_l001"/>കുന്തി</orth><pron notation="transliteration">kundi</pron></form>  <etym>S.</etym> <gramGrp><pos>N. pr.</pos></gramGrp> <sense><def xml:lang="en">of a tribe.</def> <note>—</note> <def xml:lang="en">the mother</def> <def xml:lang="en"><lb facs="#p300_r52_l001"/>of the Pāṇḍavas.</def> <bibl>Bhr.</bibl> <note>—</note> in <cit type="example"><quote xml:lang="ml">ചാണക കു</quote></cit> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r54_l001"/>ന്തി</quote></cit> <def xml:lang="en">ball,</def></sense> <etym>M.</etym> <entry type="derived"><form><orth>ആനകുന്തി</orth></form> <etym>(C. — ഗുന്ധി)</etym> <gramGrp><pos>N. pr.</pos></gramGrp> <sense><def xml:lang="en">resi-</def> <def xml:lang="en"><lb facs="#p300_r56_l001"/>dence of Rāyar</def> <bibl>KU.</bibl></sense></entry></entry>
        <entry xml:id="p300_e09" facs="#p300_r58_l001 #p300_r60_l001 #p300_r62_l001 #p300_r64_l001 #p300_r66_l001 #p300_r68_l001 #p300_r70_l001 #p300_r72_l001 #p300_r74_l001"><form type="lemma"><orth><lb facs="#p300_r58_l001"/>കുന്തുക</orth><pron notation="transliteration">kunduya</pron></form>  <etym>T. So.</etym> <sense><def xml:lang="en">To be lifted up</def> <def xml:lang="en">to shrivel up);</def> <def xml:lang="en">to walk on tiptoe.</def></sense> <etym>(C.</etym> <etym><lb facs="#p300_r60_l001"/>Te. Tu.</etym> <entry type="derived"><form><orth><lb facs="#p300_r62_l001"/>കുന്തിക്ക</orth></form> <gramGrp><pos>freq.</pos></gramGrp> <sense n="1"><lbl type="senseNumber">1.</lbl> <def xml:lang="en">id.</def> <cit type="example"><quote xml:lang="ml">ബ്രാഹ്മണ്യംകൊണ്ടു ക</quote></cit> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r64_l001"/>ന്തിച്ചു കുന്തിച്ചു ബ്രഹ്മാവും ഇച്ചിദ്ദവ് എന്ന</quote></cit> <cit type="example"><quote xml:lang="ml"><lb facs="#p300_r66_l001"/>ചിലർ</quote><bibl>GP.</bibl></cit> </sense> <sense n="2"><lbl type="senseNumber">2.</lbl> <def xml:lang="en">to prance, stumble, trip</def> <bibl>V2.</bibl> <bibl><lb facs="#p300_r68_l001"/>VN.</bibl></sense> </entry><entry type="derived"><form><orth>കുന്തിപ്പു</orth></form> <sense><def xml:lang="en">gallop</def> <bibl>V2.</bibl> <note><lb facs="#p300_r70_l001"/>amend tiptoe. amma</note> <bibl>VN.</bibl></sense> </entry><entry type="derived"><form><orth><lb facs="#p300_r72_l001"/>കുന്തുകണ്ണു</orth></form> <sense><bibl>V1.</bibl> <def xml:lang="en">the eye starting out of the socket</def> <xr type="syn"><lb facs="#p300_r74_l001"/>(also കുന്നു—).</xr></sense></entry></entry>

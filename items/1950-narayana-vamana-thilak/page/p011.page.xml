        </TextEquiv>
        <TextEquiv index="2" conf="0.722" comments="Tesseract reading used for alignment (own encoding)">
          <Unicode>20 കേവലം പാശ്ചാത്വമെന്നു, യേശുക്രിസ്‌തു ത</Unicode>
        </TextEquiv>

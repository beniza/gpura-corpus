":"sarvam"}]},{"id":"p002_r62","type":"paragraph","production":"printed","bbox":[77,2215,574,68],"lines":[{"id":"p002_r62_l001","bbox":[77,2215,97,25],"text":"തത്രെ.","src":"ai","unclear":true},{"id":"p002_r62_l002","bbox":[112,2248,539,35],"text":"അമിനാൾ ബ. സഹോദരരേ, പ്രി","src":"ai","unclear":true}]},{"id":"p002_r63","type":"paragraph","production":"printed","bbox":[72,2285,579,80],"lines":[{"id":"p002_r63_l001","bbox":[77,2285,574,39],"text":"യമക്കളേ, നാം സമരോദിച്ചിരിക്കുന്ന","src":"sarvam"},{"id":"p002_r63_l002","bbox":[72,2324,577,41],"text":"ഈ പ്രസ്ഥാനത്തെ ഉള്ളഴിഞ്ഞു സഹാ","src":"sarvam"}]},{"id":"p002_r64","type":"paragraph","production":"printed","bbox":[71,2368,577,73],"lines":[{"id":"p002_r64_l001","bbox":[71,2368,575,35],"text":"യിക്കണമെന്നു് ഒന്നുകൂടി അഭ്യർത്ഥിക്ക","src":"ai","unclear":true},{"id":"p002_r64_l002","bbox":[77,2409,571,32],"text":"ന. നിങ്ങളെ ഓരോരുത്തരെയും കണ്ടു","src":"ai","unclear":true}]},{"id":"p002_r65","type":"heading","production":"printed","bbox":[72,2445,575,38],"lines":[{"id":"p002_r65_l001","bbox":[72,2445,575,38],"text":"നീങ്ങളോടു് ഈ വിഷയത്തെപ്പറ്റി സം","src":"sarvam"}]},{"id":"p002_r66","type":"paragraph","production":"printed","bbox":[70,2485,2382,130],"lines":[{"id":"p002_r66_l001","bbox":[70,2485,577,36],"text":"സാരിക്കണമെന്നു് നമുക്കു് ആഗ്രഹം","src":"ai","unclear":true},{"id":"p002_r66_l002","bbox":[73,2517,2349,53],"text":"ണ്ടു്. അതിനു് ഇന്നു് നമുക്ക സാധ്യമ വ്യശക്തി പ്രകാശിപ്പിക്കാൻ ഈശോ പ്രൊപ്രൈറ്റർ & മാനേജർ സി. ജെ. ജോസഫു്, വായ്പൂരു","src":"ai","unclear":true},{"id":"p002_r66_l003","bbox":[75,2562,2377,53],"text":"ല്ല. അതിനാൽ ഈ അഭ്യർത്ഥനയെ അ തള്ളാറായില്ല. പരിപൂർണ്ണമായി ദൈവപ Artist T. P. Joseph","src":"ai","unclear":true}]},{"id":"p002_r67","type":"heading","production":"printed","bbox":[77,2607,571,32],"lines":[{"id":"p002_r67_l001","bbox":[77,2607,571,32],"text":"ന്തർഹിക്കുന്ന ഗൗരവത്തോടെ സ്വീകരി","src":"sarvam"}]},{"id":"p002_r68","type":"paragraph","production":"printed","bbox":[73,2668,2385,93],"lines":[{"id":"p002_r68_l001","bbox":[73,2668,2385,50],"text":"ങ്ങൾ പാടുള്ളവിധം സഹായിക്കുവിൻ. ജീവിക്കുന്നതു്. പിന്നെയും ദൈവവദ ല്ലാവരും പട്ടിണിക്കാരായാൽ പട്ടിണി കനെ ലോകം നാല്പതു നൂറ്റാണ്ടു് പ്രതി","src":"ai","unclear":true},{"id":"p002_r68_l002","bbox":[112,2725,534,36],"text":"ഇന്നത്തെ ദുഃഖദുഷ്ടമായ സ്ഥിതിവി","src":"ai","unclear":true}]},{"id":"p002_r69","type":"heading","production":"printed","bbox":[70,2764,575,39],"lines":[{"id":"p002_r69_l001","bbox":[70,2764,575,39],"text":"തികൾ ഭേദപ്പെടുത്തുന്നതിനു് പരിശുദ്ധ","src":"sarvam"}]},{"id":"p002_r70","type":"paragraph","production":"printed","bbox":[71,2786,2385,171],"lines":[{"id":"p002_r70_l001","bbox":[71,2786,2385,53],"text":"കന്യകാമാതാവിന്റെ മാധ്യസ്ഥം ലഭി ഈ അരുളപ്പാടു കേട്ടു്. ദൈവം അവരെ വെറുതെവിട്ടിരിക്കുന്ന നാല്പതുദിവസം തപസ്സുചെയ്ത. ഈശോ","src":"ai","unclear":true},{"id":"p002_r70_l002","bbox":[71,2826,2385,54],"text":"ക്കവാൻ ഒക്ടോബർ മാസംമുഴുവനും കൂട ഈ മറുപടി നല്ലൊടിയായിരുന്നു തു്. ഉയിർത്തിട്ടു് നാല്പതു ദിവസം അപ്പസ്തോ","src":"ai","unclear":true},{"id":"p002_r70_l003","bbox":[72,2881,572,40],"text":"തൽ ഭക്തിയോടുകൂടി അനുഷ്ഠിക്കണമെ","src":"ai","unclear":true},{"id":"p002_r70_l004","bbox":[71,2907,2382,50],"text":"നു് സെപ്റ്റംബർ 15-ാം തീയതിയിലെ ഒരു ഗ്രഹം ശീഘ്രമായി. ഒന്നാമതെ സമ ങ്ങളാൽ ആവുന്നതു് ചെയ്യണം. അപ്പം സ്വർഗ്ഗാരോഹണം ചെയ്തതു്. ഒരു പ","src":"ai","unclear":true}]},{"id":"p002_r71","type":"paragraph","production":"printed","bbox":[70,2964,575,77],"lines":[{"id":"p002_r71_l001","bbox":[73,2964,567,34],"text":"ചാക്രികലേഖനത്തിൽ ഭാഗ്യത്തോടെ ന","src":"sarvam"},{"id":"p002_r71_l002","bbox":[70,3003,575,38],"text":"മ്മെ ഭരിക്കുന്ന പന്ത്രണ്ടാംപീയൂസ് മാർ","src":"sarvam"}]},{"id":"p002_r72","type":"heading","production":"printed","bbox":[69,3037,574,50],"lines":[{"id":"p002_r72_l001","bbox":[69,3037,574,50],"text":"പ്പാപ്പാ ആവശ്യപ്പെട്ടിരിക്കുന്ന. കൊന്ത","src":"ai","unclear":true}]},{"id":"p002_r73","type":"paragraph","production":"printed","bbox":[68,3082,574,115],"lines":[{"id":"p002_r73_l001","bbox":[68,3082,574,39],"text":"നമസ്കാരത്തിന്റെ പ്രാധാന്യത്തെ ഊ","src":"sarvam"},{"id":"p002_r73_l002","bbox":[68,3122,573,39],"text":"ന്നിപ്പറഞ്ഞുകൊണ്ടു് തീരുമേനി തുടരു","src":"sarvam"},{"id":"p002_r73_l003","bbox":[69,3164,567,33],"text":"ന്നു: \"ലോകത്തിന്റെ ദുരവസ്ഥ ഇന്നു","src":"sarvam"}]},{"id":"p002_r74","type":"paragraph","production":"printed","bbox":[68,3199,2385,82],"lines":[{"id":"p002_r74_l001","bbox":[71,3199,2382,42],"text":"ഏത്ര കണ്ടു കഠിനമാണോ അത്ര കണ്ടു ക്ഷ ത്തു പ്രഖ്യാപിച്ചു. അത്യാത്മികതകൊണ്ടു് ആ സാധനങ്ങളോ കടം ഇന്നതു്. തന്നെ അടുത്ത ദിവസത്തെക്കു് — ഈശോ","src":"ai","unclear":true},{"id":"p002_r74_l002","bbox":[68,3239,2381,42],"text":"ഉതൽ ഭക്തിയോടുകൂടെ ഇക്കൊല്ലം കൊ ദവും അതുവഴി മനുഷ്യവംശമുഴുവനും പി തുതന്നെ മിതമായി. ഈശോയെ ഓർത്തു യെ രണ്ടാമത്തെ ആദം എന്ന വിളിക്ക","src":"ai","unclear":true}]},{"id":"p002_r75","type":"heading","production":"printed","bbox":[70,3282,572,36],"lines":[{"id":"p002_r75_l001","bbox":[70,3282,572,36],"text":"ന്തനമസ്കാരം നടത്തണമെന്ന് നാം ആ","src":"sarvam"}]},{"id":"p002_r76","type":"paragraph","production":"printed","bbox":[65,3318,2386,42],"lines":[{"id":"p002_r76_l001","bbox":[65,3318,2386,42],"text":"ഗ്രഹിക്കുന്നു. പരിശുദ്ധ പിതാവിന്റെ ത്രം പ്രദർശിപ്പിച്ചു് ഈശോ അവനെ ടിക്കു് അവൻ ചിരിക്കാനിയൽ പിറുപിറ എന്നു്, സ്വന്തം കൊച്ചച്ചൻ.","src":"ai","unclear":true}]},{"id":"p002_r77","type":"paragraph","production":"printed","bbox":[64,3360,574,77],"lines":[{"id":"p002_r77_l001","bbox":[64,3360,574,37],"text":"ഈ ഉൽബോധനമനുസരിച്ചു കൊന്ത","src":"sarvam"},{"id":"p002_r77_l002","bbox":[64,3399,574,38],"text":"നമസ്കാരം ക്രമമായും ദിവസന്തോറും ഭ","src":"sarvam"}]},{"id":"p002_r78","type":"paragraph","production":"printed","bbox":[66,3440,2388,117],"lines":[{"id":"p002_r78_l001","bbox":[66,3440,2387,42],"text":"കതിടയാടുകളുടെ നിങ്ങൾ നടത്തുവിൻ. ഡിപ്പിക്കപ്പെട്ടവയാണു്. നിങ്ങളുള്ള കാ ഗിക്കണം. മറ്റുള്ളവർ ഭോജനപ്രിയത്താ കഴിഞ്ഞലക്കം 11-ാം പേജിൽ കൊ","src":"ai","unclear":true},{"id":"p002_r78_l002","bbox":[68,3477,2386,42],"text":"കേരളത്തിലെ പ്രസ്ഥാനത്തിന്റെ വിജയത്തി ണ്ണെന്നില്ലേ? കേൾക്കന്നില്ലേ? അറിയൂ ടും മദ്യപാനത്തിലും ഈശോയെ ഉപ ട്ടത്തിന്ന “പുനഃസംസ്കരണം” എന്ന","src":"ai","unclear":true},{"id":"p002_r78_l003","bbox":[66,3519,2385,38],"text":"നായിക്കൂടി ഒക്ടോബർമാസത്തിലെ പ്ര ന്നില്ല? ഓഷൻകാലം! ഭക്ഷണസന്ധ്യ വിക്കന്നില്ലേ? അതിന പരിഹാരമായി വാർത്തയിലെ “നമ്മുടെ പിതാക്കന്മാരുടെ","src":"ai","unclear":true}]},{"id":"p002_r79","type":"heading","production":"printed","bbox":[820,1972,335,44],"lines":[{"id":"p002_r79_l001","bbox":[820,1972,335,44],"text":"ബാങ്ക് ഓഫ്","src":"sarvam"}]},{"id":"p002_r80","type":"heading","production":"printed","bbox":[756,2024,437,68],"lines":[{"id":"p002_r80_l001","bbox":[756,2024,437,68],"text":"കൊച്ചിൻ ക്ലിപ്പം","src":"ai","unclear":true}]},{"id":"p002_r81","type":"paragraph","production":"printed","bbox":[767,2099,416,108],"lines":[{"id":"p002_r81_l001","bbox":[866,2099,212,32],"text":"എറണാകുളം","src":"sarvam"},{"id":"p002_r81_l002","bbox":[767,2133,416,39],"text":"മട്ടാഞ്ചേരി, ചാലക്കുടി, തൃശൂർ,","src":"sarvam"},{"id":"p002_r81_l003","bbox":[801,2172,334,35],"text":"വില്ലിങ്ങ്ടൺ ഐലന്റ്","src":"sarvam"}]},{"id":"p002_r82","type":"heading","production":"printed","bbox":[681,2248,573,39],"lines":[{"id":"p002_r82_l001","bbox":[681,2248,573,39],"text":"ഭാര്യപീയാണു് ഈശോയെ വിജനപ്ര","src":"ai","unclear":true}]},{"id":"p002_r83","type":"paragraph","production":"printed","bbox":[676,2285,581,237],"lines":[{"id":"p002_r83_l001","bbox":[679,2285,577,44],"text":"ദേശത്തേക്കു നയിച്ചതെന്നും സുവിശേഷ","src":"sarvam"},{"id":"p002_r83_l002","bbox":[681,2329,572,33],"text":"കന്മാർ പറയുന്നു. ഇങ്ങനെയിരിക്കെ","src":"sarvam"},{"id":"p002_r83_l003","bbox":[682,2362,572,49],"text":"പിശാചിന്റെ ഉപദേശം കേട്ടു് അത്ഭു","src":"sarvam"},{"id":"p002_r83_l004","bbox":[676,2398,581,57],"text":"തം പ്രവർത്തിക്കുന്നതു് ശരിയല്ല. നീസ്സാ","src":"sarvam"},{"id":"p002_r83_l005","bbox":[681,2443,573,42],"text":"രമായ ഒരു കാര്യത്തിനുവേണ്ടി, അതും","src":"sarvam"},{"id":"p002_r83_l006","bbox":[677,2487,576,35],"text":"സ്വന്തം സൗകര്യത്തിനുവേണ്ടി സ്വദീ","src":"sarvam"}]},{"id":"p002_r84","type":"heading","produ
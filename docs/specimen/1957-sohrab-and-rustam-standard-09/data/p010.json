{"id":"p010","canvas":10,"printed":null,"width":925,"height":1390,"image":"p010.jpg","regions":[{"id":"p010_r01","type":"paragraph","production":"printed","bbox":[97,136,768,273],"lines":[{"id":"p010_r01_l001","bbox":[104,136,759,59],"text":"king himself came out to meet him.","src":"sarvam"},{"id":"p010_r01_l002","bbox":[106,184,759,56],"text":"But Rustam was angry and said, \"Your","src":"sarvam"},{"id":"p010_r01_l003","bbox":[100,231,764,50],"text":"men have stolen my horse. If I do not","src":"sarvam"},{"id":"p010_r01_l004","bbox":[99,274,763,57],"text":"get it back I will kill you and burn your","src":"sarvam"},{"id":"p010_r01_l005","bbox":[97,320,765,57],"text":"city.\" So the king sent out his men to","src":"sarvam"},{"id":"p010_r01_l006","bbox":[97,369,361,40],"text":"look for the horse.","src":"sarvam"}]},{"id":"p010_r02","type":"paragraph","production":"printed","bbox":[92,468,767,235],"lines":[{"id":"p010_r02_l001","bbox":[94,468,763,51],"text":"palace with the king. That night as he","src":"ai","unclear":true},{"id":"p010_r02_l002","bbox":[94,516,761,49],"text":"lay asleep, he had a sweet dream. He","src":"ai","unclear":true},{"id":"p010_r02_l003","bbox":[94,563,765,51],"text":"thought he saw a beautiful girl standing","src":"ai","unclear":true},{"id":"p010_r02_l004","bbox":[92,610,762,48],"text":"by his side. He opened his eyes and found","src":"ai","unclear":true},{"id":"p010_r02_l005","bbox":[93,654,760,49],"text":"that the dream had come true. For he","src":"ai","unclear":true}]},{"id":"p010_r03","type":"paragraph","production":"printed","bbox":[173,421,686,53],"lines":[{"id":"p010_r03_l001","bbox":[173,421,686,53],"text":"Meanwhile Rustam stayed in the","src":"ai","unclear":true}]},{"id":"p010_r04","type":"paragraph","production":"printed","bbox":[456,710,398,410],"lines":[{"id":"p010_r04_l001","bbox":[467,710,387,36],"text":"saw a beautiful girl","src":"sarvam"},{"id":"p010_r04_l002","bbox":[464,759,388,36],"text":"standing before him.","src":"sarvam"},{"id":"p010_r04_l003","bbox":[465,800,384,38],"text":"She was fairer than","src":"sarvam"},{"id":"p010_r04_l004","bbox":[460,851,387,33],"text":"all the other ladies","src":"sarvam"},{"id":"p010_r04_l005","bbox":[460,894,388,39],"text":"that he had ever","src":"sarvam"},{"id":"p010_r04_l006","bbox":[459,941,390,39],"text":"seen. Even at first","src":"sarvam"},{"id":"p010_r04_l007","bbox":[457,987,388,41],"text":"sight he fell in love","src":"sarvam"},{"id":"p010_r04_l008","bbox":[457,1034,386,37],"text":"with her. \"Who are","src":"sarvam"},{"id":"p010_r04_l009","bbox":[456,1078,353,42],"text":"you?\" he asked her.","src":"sarvam"}]},{"id":"p010_r05","type":"heading","production":"printed","bbox":[84,1170,205,38],"lines":[{"id":"p010_r05_l001","bbox":[84,1170,205,38],"text":"“and I am","src":"ai","unclear":true}]},{"id":"p010_r06","type":"heading","production":"printed","bbox":[83,1217,204,40],"lines":[{"id":"p010_r06_l001","bbox":[83,1217,204,40],"text":"Samangan.\"","src":"sarvam"}]},{"id":"p010_r07","type":"paragraph","production":"printed","bbox":[229,1129,609,90],"lines":[{"id":"p010_r07_l001","bbox":[229,1129,609,44],"text":"\"I am Tahminah,\" she answered,","src":"sarvam"},{"id":"p010_r07_l002","bbox":[308,1172,530,47],"text":"\"and I am the daughter of the king of","src":"sarvam"}]}],"unplaced":2}